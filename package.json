{
  "name": "santiago-duarte-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender && npm run audit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .ssg --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "audit": "node scripts/audit-seo.mjs",
    "preview": "vite preview",
    "og": "npm run build:ssr && node scripts/generate-og.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lenis": "^1.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "node-html-parser": "^9.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
